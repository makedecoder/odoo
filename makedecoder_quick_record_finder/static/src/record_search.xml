<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="makedecoder_quick_record_finder.RecordSearchCommand">
        <div class="o_command_default d-flex align-items-center gap-3 w-100 px-4 py-2 cursor-pointer">
            <span class="d-flex align-items-center justify-content-center flex-shrink-0 rounded bg-primary-subtle text-primary p-2" style="width: 32px; height: 32px;" aria-hidden="true">
                <i t-att-class="'fa fa-fw fa-lg ' + this.props.icon"/>
            </span>
            <t t-call-slot="name"/>
            <span class="ms-auto flex-shrink-0">
                <t t-call-slot="focusMessage"/>
            </span>
        </div>
    </t>
</templates>
